*&---------------------------------------------------------------------*
*& Report ZVALID_SUP_PRODUCT_2515
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT ZVALID_SUP_PRODUCT_2515.

DATA: wa_product TYPE zsup_prod_2515.

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 20(60) TEXT-003.
SELECTION-SCREEN END OF LINE.

SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME TITLE text-001.

PARAMETERS:
  r_create RADIOBUTTON GROUP g1 DEFAULT 'X',
  r_read   RADIOBUTTON GROUP g1,
  r_update RADIOBUTTON GROUP g1,
  r_delete RADIOBUTTON GROUP g1.

SELECTION-SCREEN END OF BLOCK b1.


"--------------------------------------------------
" PRODUCT DETAILS
"--------------------------------------------------

SELECTION-SCREEN BEGIN OF BLOCK b2 WITH FRAME TITLE text-002.

PARAMETERS:
  p_id       TYPE zsup_prod_2515-product_id,
  p_name     TYPE zsup_prod_2515-product_name,
  p_cate     TYPE zsup_prod_2515-category,
  p_brand    TYPE zsup_prod_2515-brand,
  p_unit     TYPE zsup_prod_2515-unit,
  p_qty      TYPE zsup_prod_2515-quantity,
  p_price    TYPE zsup_prod_2515-price,
  p_supp     TYPE zsup_prod_2515-supplier,
  p_status   TYPE zsup_prod_2515-status.

SELECTION-SCREEN END OF BLOCK b2.


"--------------------------------------------------
" INITIALIZATION
"--------------------------------------------------



"--------------------------------------------------
" VALIDATION
"--------------------------------------------------

AT SELECTION-SCREEN.

  "Product ID validation
  IF p_id IS INITIAL.

    MESSAGE 'Product ID is required' TYPE 'E'.

  ENDIF.


  "Create validation
  IF r_create = 'X'.

    IF p_name IS INITIAL.
      MESSAGE 'Product Name is required' TYPE 'E'.
    ENDIF.

    IF p_cate IS INITIAL.
      MESSAGE 'Category is required' TYPE 'E'.
    ENDIF.

    IF p_brand IS INITIAL.
      MESSAGE 'Brand is required' TYPE 'E'.
    ENDIF.

    IF p_unit IS INITIAL.
      MESSAGE 'Unit is required' TYPE 'E'.
    ENDIF.

    IF p_qty <= 0.
      MESSAGE 'Quantity must be greater than zero' TYPE 'E'.
    ENDIF.

    IF p_price <= 0.
      MESSAGE 'Price must be greater than zero' TYPE 'E'.
    ENDIF.

    IF p_supp IS INITIAL.
      MESSAGE 'Supplier is required' TYPE 'E'.
    ENDIF.

    IF p_status IS INITIAL.
      MESSAGE 'Status is required' TYPE 'E'.
    ENDIF.

  ENDIF.


  "Update validation
  IF r_update = 'X'.

    IF p_name IS INITIAL.
      MESSAGE 'Product Name is required' TYPE 'E'.
    ENDIF.

    IF p_qty <= 0.
      MESSAGE 'Quantity must be greater than zero' TYPE 'E'.
    ENDIF.

    IF p_price <= 0.
      MESSAGE 'Price must be greater than zero' TYPE 'E'.
    ENDIF.

  ENDIF.


  "Status validation
  IF p_status IS NOT INITIAL.

    IF p_status <> 'A' AND p_status <> 'I'.

      MESSAGE 'Status must be A or I' TYPE 'E'.

    ENDIF.

  ENDIF.


"--------------------------------------------------
" MAIN PROCESSING
"--------------------------------------------------

START-OF-SELECTION.


  "==================================================
  " CREATE
  "==================================================

  IF r_create = 'X'.

    CLEAR wa_product.

    SELECT SINGLE *
      FROM zsup_prod_2515
      INTO wa_product
      WHERE product_id = p_id.

    IF sy-subrc = 0.

      MESSAGE 'Product ID already exists' TYPE 'E'.

    ENDIF.


    wa_product-product_id   = p_id.
    wa_product-product_name = p_name.
    wa_product-category     = p_cate.
    wa_product-brand        = p_brand.
    wa_product-unit         = p_unit.
    wa_product-quantity     = p_qty.
    wa_product-price        = p_price.
    wa_product-supplier     = p_supp.
    wa_product-status       = p_status.


    INSERT zsup_prod_2515 FROM wa_product.

    IF sy-subrc = 0.

      COMMIT WORK.

      MESSAGE 'Product created successfully' TYPE 'S'.

    ELSE.

      MESSAGE 'Product creation failed' TYPE 'E'.

    ENDIF.

  ENDIF.


  "==================================================
  " READ
  "==================================================

  IF r_read = 'X'.

    CLEAR wa_product.

    SELECT SINGLE *
      FROM zsup_prod_2515
      INTO wa_product
      WHERE product_id = p_id.

    IF sy-subrc <> 0.

      MESSAGE 'Product ID not found' TYPE 'E'.

    ENDIF.


    WRITE: / '--------------------------------------------'.
    WRITE: / '       SUPERMARKET PRODUCT DETAILS'.
    WRITE: / '--------------------------------------------'.

    WRITE: / 'Product ID   :', wa_product-product_id.
    WRITE: / 'Product Name :', wa_product-product_name.
    WRITE: / 'Category     :', wa_product-category.
    WRITE: / 'Brand        :', wa_product-brand.
    WRITE: / 'Unit         :', wa_product-unit.
    WRITE: / 'Quantity     :', wa_product-quantity.
    WRITE: / 'Price        :', wa_product-price.
    WRITE: / 'Supplier     :', wa_product-supplier.
    WRITE: / 'Status       :', wa_product-status.

    WRITE: / '--------------------------------------------'.

  ENDIF.


  "==================================================
  " UPDATE
  "==================================================

  IF r_update = 'X'.

    CLEAR wa_product.

    SELECT SINGLE *
      FROM zsup_prod_2515
      INTO wa_product
      WHERE product_id = p_id.

    IF sy-subrc <> 0.

      MESSAGE 'Product ID not found' TYPE 'E'.

    ENDIF.


    wa_product-product_name = p_name.
    wa_product-category     = p_cate.
    wa_product-brand        = p_brand.
    wa_product-unit         = p_unit.
    wa_product-quantity     = p_qty.
    wa_product-price        = p_price.
    wa_product-supplier     = p_supp.
    wa_product-status       = p_status.


    UPDATE zsup_prod_2515 FROM wa_product.

    IF sy-subrc = 0.

      COMMIT WORK.

      MESSAGE 'Product updated successfully' TYPE 'S'.

    ELSE.

      MESSAGE 'Product update failed' TYPE 'E'.

    ENDIF.

  ENDIF.


  "==================================================
  " DELETE
  "==================================================

  IF r_delete = 'X'.

    CLEAR wa_product.

    SELECT SINGLE *
      FROM zsup_prod_2515
      INTO wa_product
      WHERE product_id = p_id.

    IF sy-subrc <> 0.

      MESSAGE 'Product ID not found' TYPE 'E'.

    ENDIF.


    DELETE FROM zsup_prod_2515
      WHERE product_id = p_id.

    IF sy-subrc = 0.

      COMMIT WORK.

      MESSAGE 'Product deleted successfully' TYPE 'S'.

    ELSE.

      MESSAGE 'Product deletion failed' TYPE 'E'.

    ENDIF.

  ENDIF.

"--------------------------------------------------
" FOOTER
"--------------------------------------------------

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 20(60) text-004.
SELECTION-SCREEN END OF LINE.
